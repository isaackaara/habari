# Database
DATABASE_URL=postgresql://habari:habari@localhost:5434/habari?schema=public

# Redis (used by BullMQ scheduler)
REDIS_URL=redis://localhost:6379

# Telegram Bot
# Get from @BotFather: /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Google OAuth (for Gmail read access)
# Create at console.cloud.google.com -> APIs & Services -> Credentials
# Add http://localhost:3000/oauth/callback to Authorized redirect URIs
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# OpenRouter (for AI email summarisation - optional, falls back to raw format)
OPENROUTER_API_KEY=your_openrouter_key

# Server
PORT=3000

# Admin Telegram chat IDs (comma-separated) - these users can run /reset
ADMIN_CHAT_IDS=
